{
  "name": "cloud-cache-action",
  "version": "1.5.0",
  "description": "High-performance GitHub Action caching to any S3-compatible storage with actions/cache v4-v6 parity",
  "main": "dist/restore/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && ncc build -o dist/restore src/restore.ts && ncc build -o dist/save src/save.ts && ncc build -o dist/restore-only src/restoreOnly.ts && ncc build -o dist/save-only src/saveOnly.ts && ncc build -o dist/prune src/prune.ts && ncc build -o dist/inspect src/inspect.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:contract": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/contract",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ci.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xSAVIKx/cloud-cache-action.git"
  },
  "keywords": [
    "actions",
    "github-actions",
    "cache",
    "s3",
    "r2",
    "gcs",
    "backblaze-b2",
    "fastly",
    "garage",
    "seaweedfs",
    "minio"
  ],
  "author": {
    "name": "Yurii Serhiichuk",
    "url": "https://serhiichuk.dev"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/glob": "^0.6.1",
    "@actions/io": "^3.0.2",
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/lib-storage": "^3.1129.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vercel/ncc": "^0.45.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.42",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
